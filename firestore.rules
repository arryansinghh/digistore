rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Blueprints ---
    
    function isValidUser(data) {
      return data.uid is string && 
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email == request.auth.token.email;
    }

    function isValidOrder(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.amount is number &&
             data.amount >= 0 &&
             data.status in ['pending', 'completed'];
    }

    function isValidReview(data) {
      return data.productId is string &&
             data.userId == request.auth.uid &&
             data.rating is number &&
             data.rating >= 1 && data.rating <= 5 &&
             data.comment is string &&
             data.comment.size() >= 3 && data.comment.size() <= 1000 &&
             data.createdAt == request.time;
    }

    // --- match Blocks ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().keys().hasAll(['uid', 'email', 'createdAt']) &&
                    incoming().size() >= 3;
      allow update: if isOwner(userId) && 
                    incoming().uid == existing().uid &&
                    incoming().email == existing().email &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                    isValidOrder(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().createdAt == request.time;
      
      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && 
                    isValidId(reviewId) &&
                    isValidReview(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
